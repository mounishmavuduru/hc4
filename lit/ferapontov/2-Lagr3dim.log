    *** a similar trick with the Hessian
    skip;
    nskip nbb;
    repeat; 
    id [Hess]*[1/Hess]=1;
    id f(a + b)^2*f(2*c) = -( - f(2*a)*f(2*b)*f(2*c) + f(2*b)*f(a + c)^2
         - 2*f(a + b)*f(a + c)*f(b + c) + f(2*a)*f(b + c)^2) - [Hess];
    id f(2*b)*[1/f(2*b)]=1;
    endrepeat;
    *** now you can see how this works!
    Brackets [1/x],[1/y],[1/z],[1/Hess],[Hess];
    print[] nbb;
