    **** finally in four modules we combine all terms to form the
    **** complete sum "all"
    skip;
    L all1=Nij*(Bkj + Bik);
    repeat; 
    id mu(i?)^2=-(f(a+a)+2*f(a+b)*mu(i)+2*f(a+c)*la(i)+f(c+c)*la(i)^2
       +2*f(c+b)*mu(i)*la(i))*[1/f(2*b)];
    id f(2*b)*[1/f(2*b)]=1;
    endrepeat;
    Brackets [1/x],[1/y],[1/z],[1/Hess],[Hess];
    print[] all1;
    .sort

