   NUdD =
       + [1/Hess]*[1/x]^2 * (  9369 terms )

       + [1/Hess]^2*[1/x]*[1/y] * (  9518 terms )

       + [1/Hess]^2*[1/x]*[1/z] * (  9518 terms )

